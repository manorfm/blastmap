{
  "type": "object",
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "description": "Table/collection/entity name."},
          "kind": {"type": "string", "enum": ["sql_table", "document", "cache", "other"]},
          "engine": {
            "type": "string",
            "enum": ["postgres", "mysql", "mongodb", "cassandra", "dynamodb", "redis", "elasticsearch", "sqlite", "unknown"],
            "description": "The concrete database engine, inferred from the evidence (dependency manifest, config files, driver imports). Use \"unknown\" when the model/entity definition alone doesn't name one and no manifest/config evidence resolves it — never guess."
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {"type": "string"},
                "type_desc": {"type": "string"}
              },
              "required": ["field", "type_desc"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "kind", "engine", "fields"],
        "additionalProperties": false
      }
    }
  },
  "required": ["entities"],
  "additionalProperties": false
}
