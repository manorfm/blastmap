{
  "type": "object",
  "required": ["plan_id", "change_unit", "minimal_reading", "validation"],
  "additionalProperties": false,
  "properties": {
    "plan_id": {"type": "string", "pattern": "^cp_[1-9][0-9]*$"},
    "change_unit": {"type": "object"},
    "minimal_reading": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["service", "purpose", "recommended_query"],
        "additionalProperties": false,
        "properties": {
          "service": {"type": "string"},
          "purpose": {"type": "string"},
          "recommended_query": {
            "type": "object",
            "required": ["tool", "arguments"],
            "additionalProperties": false,
            "properties": {
              "tool": {"type": "string", "enum": ["describe_messages", "describe_service", "list_entrypoints", "describe_persistence", "describe_feature_flags", "describe_configuration", "describe_runtime_configuration"]},
              "arguments": {
                "type": "object",
                "required": ["service"],
                "additionalProperties": false,
                "properties": {"service": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "evidence_follow_up": {
      "type": "object",
      "required": ["reason", "recommended_next_step", "workloads", "recommended_query"],
      "additionalProperties": false,
      "properties": {
        "reason": {"type": "string"},
        "recommended_next_step": {
          "type": "string",
          "enum": ["inspect_change_unit_evidence", "query_runtime_configuration"]
        },
        "workloads": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "name", "container"],
            "additionalProperties": false,
            "properties": {
              "kind": {"type": "string"},
              "name": {"type": "string"},
              "container": {"type": "string"},
              "evidence_total": {"type": "integer", "minimum": 1}
            }
          }
        },
        "recommended_query": {
          "type": "object",
          "required": ["tool", "arguments"],
          "additionalProperties": false,
          "properties": {
            "tool": {"const": "describe_runtime_configuration"},
            "arguments": {
              "type": "object",
              "required": ["service"],
              "additionalProperties": false,
              "properties": {"service": {"type": "string"}}
            }
          }
        },
        "pagination": {
          "type": "object",
          "required": ["limit", "offset", "next_offset", "continue_when"],
          "additionalProperties": false,
          "properties": {
            "limit": {"type": "integer", "minimum": 1, "maximum": 500},
            "offset": {"const": 0},
            "next_offset": {"type": "integer", "minimum": 1, "maximum": 500},
            "continue_when": {"const": "source_import_truncated"}
          }
        }
      }
    },
    "validation": {"type": "array", "items": {"type": "string"}}
  }
}
