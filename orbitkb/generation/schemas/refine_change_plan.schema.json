{
  "type": "object",
  "required": ["plan_id", "status", "selected_decisions", "remaining_decision_points", "change_units"],
  "additionalProperties": false,
  "properties": {
    "plan_id": {"type": "string", "pattern": "^cp_[1-9][0-9]*$"},
    "status": {"type": "string", "enum": ["ready", "needs_decision", "insufficient_evidence", "stale_knowledge"]},
    "selected_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "option"],
        "additionalProperties": false,
        "properties": {"id": {"type": "string"}, "option": {"type": "string"}}
      }
    },
    "remaining_decision_points": {"type": "array", "items": {"type": "object"}},
    "change_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "service", "target", "action", "reason", "preconditions", "related_contracts", "dependencies", "validation", "confidence", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "service": {"type": "string"},
          "target": {
            "type": "object",
            "required": ["role", "symbol", "evidence"],
            "additionalProperties": false,
            "properties": {
              "role": {"type": "string", "enum": ["contract", "integration"]},
              "symbol": {"type": "string"},
              "evidence": {"type": "array", "items": {"type": "object"}}
            }
          },
          "action": {"type": "string", "enum": ["validate", "modify", "review"]},
          "reason": {"type": "string"},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "related_contracts": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "validation": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {"type": "array", "items": {"type": "object"}}
        }
      }
    }
  }
}
