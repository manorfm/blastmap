{
  "type": "object",
  "required": ["plan_id", "status", "summary", "units", "pagination"],
  "additionalProperties": false,
  "properties": {
    "plan_id": {"type": "string", "pattern": "^cp_[1-9][0-9]*$"},
    "status": {"type": "string", "enum": ["no_manual_checks", "pending", "failed", "reported_passed"]},
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "pending"],
      "additionalProperties": false,
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "pending": {"type": "integer", "minimum": 0}
      }
    },
    "units": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "status", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pending", "failed", "reported_passed"]},
          "summary": {
            "type": "object",
            "required": ["total", "passed", "failed", "pending"],
            "additionalProperties": false,
            "properties": {
              "total": {"type": "integer", "minimum": 1},
              "passed": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0},
              "pending": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "pagination": {
      "type": "object",
      "required": ["limit", "offset", "total", "truncated", "next_offset"],
      "additionalProperties": false,
      "properties": {
        "limit": {"type": "integer", "minimum": 1, "maximum": 50},
        "offset": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "truncated": {"type": "boolean"},
        "next_offset": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
