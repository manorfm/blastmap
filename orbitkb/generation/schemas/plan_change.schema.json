{
  "type": "object",
  "required": [
    "plan_id",
    "status",
    "surface",
    "decision_points",
    "change_units",
    "ci_validation_commands",
    "unknowns",
    "budget"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_id": {"type": ["string", "null"]},
    "status": {
      "type": "string",
      "enum": ["ready", "needs_decision", "insufficient_evidence", "stale_knowledge"]
    },
    "surface": {
      "type": "object",
      "required": ["primary", "secondary", "contracts_at_risk"],
      "additionalProperties": false,
      "properties": {
        "primary": {"type": "array", "items": {"type": "object"}},
        "secondary": {"type": "array", "items": {"type": "object"}},
        "contracts_at_risk": {"type": "array", "items": {"type": "object"}}
      }
    },
    "decision_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "why_blocking", "options", "recommended_default", "owner", "contract", "consumers", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "why_blocking": {"type": "string"},
          "options": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "recommended_default": {"type": "string"},
          "owner": {"type": "string"},
          "contract": {"type": "string"},
          "consumers": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "change_units": {"type": "array", "items": {"type": "object"}},
    "ci_validation_commands": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["kind", "command", "workflow_path"],
        "additionalProperties": false,
        "properties": {
          "kind": {"type": "string", "enum": ["test", "build"]},
          "command": {"type": "string", "minLength": 1},
          "workflow_path": {"type": "string", "minLength": 1}
        }
      }
    },
    "unknowns": {"type": "array", "items": {"type": "object"}},
    "budget": {
      "type": "object",
      "required": ["requested_tokens", "estimated_tokens", "measurement", "truncated"],
      "additionalProperties": false,
      "properties": {
        "requested_tokens": {"type": "integer", "minimum": 1},
        "estimated_tokens": {"type": "integer", "minimum": 0},
        "measurement": {"type": "string", "enum": ["tiktoken:o200k_base", "byte_estimate"]},
        "truncated": {"type": "boolean"}
      }
    }
  }
}
