{
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "direction": {"type": "string", "enum": ["publishes", "consumes"]},
          "channel": {"type": "string", "description": "Topic/queue/exchange name."},
          "provider": {
            "type": "string",
            "enum": ["kafka", "rabbitmq", "sqs", "sns", "service_bus", "activemq", "nats", "unknown"],
            "description": "The concrete broker/vendor, inferred from the evidence (imports, client classes, annotations). Use \"unknown\" when the code only shows a transport-agnostic abstraction (JMS, Celery, NestJS microservices) and no configuration evidence resolves it — never guess."
          },
          "shape": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {"type": "string"},
                "type_desc": {"type": "string"}
              },
              "required": ["field", "type_desc"],
              "additionalProperties": false
            }
          },
          "description": {"type": "string", "description": "Why/when this message is emitted or handled."}
        },
        "required": ["direction", "channel", "provider", "shape", "description"],
        "additionalProperties": false
      }
    }
  },
  "required": ["messages"],
  "additionalProperties": false
}
